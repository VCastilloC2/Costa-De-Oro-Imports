# ==========================================================
# .env.example  ->  cópialo como ".env" (está en .gitignore) y rellena los valores.
# Spring lo carga solo: spring.config.import=optional:file:.env[.properties]
# El resto de variables (BD, OAuth2, Cloudinary...) están en .env.template
# ==========================================================

# ----------------------------------------------------------
# PERFIL: local (por defecto) | cloud
#   local -> FastAPI en http://localhost:8000, API key opcional, logs DEBUG
#   cloud -> FASTAPI_BASE_URL y FASTAPI_API_KEY obligatorias y solo https
# ----------------------------------------------------------
SPRING_PROFILES_ACTIVE=local

# ----------------------------------------------------------
# SERVICIO FASTAPI
# ----------------------------------------------------------
# Local:
FASTAPI_BASE_URL=http://localhost:8000
# Cloud (ejemplo):
# FASTAPI_BASE_URL=https://costa-de-oro-imports-python.onrender.com

# Clave de servicio emitida por FastAPI (empieza por "cdo_pk_", se muestra una sola vez):
#   POST /api/v1/predictions/clients  (Authorization: Bearer <JWT de ADMIN>)
#   body: {"name":"spring-boot","scopes":["predictions:read","predictions:generate"]}
# Cada entorno (local / cloud) debe tener su PROPIA clave; se revoca con DELETE /api/v1/predictions/clients/{id}
FASTAPI_API_KEY=

# Timeouts (formato Duration de Spring: 500ms, 3s, 1m)
FASTAPI_CONNECT_TIMEOUT=3s
FASTAPI_READ_TIMEOUT=15s
# Predicciones: la primera llamada entrena el modelo y puede tardar bastante
FASTAPI_PREDICTION_READ_TIMEOUT=120s

# Reintentos ante red caída / timeout de conexión / 5xx / 429.
# Nunca se reintentan los 4xx ni los timeouts de lectura (FastAPI sigue procesando).
FASTAPI_RETRY_MAX_RETRIES=2
FASTAPI_RETRY_DELAY=300ms
FASTAPI_RETRY_MULTIPLIER=2.0
FASTAPI_RETRY_MAX_DELAY=3s

# ----------------------------------------------------------
# VALKEY / REDIS
# ----------------------------------------------------------
# Local (docker compose up redis):
VALKEY_URL=redis://localhost:6379
REDIS_SSL_ENABLED=false
# Cloud (Layerbase exige TLS -> "rediss://" con doble s):
# VALKEY_URL=rediss://default:<password>@<host>:6379
# REDIS_SSL_ENABLED=true

REDIS_ENABLED=true
REDIS_CONNECT_TIMEOUT=5s
REDIS_TIMEOUT=3s
